{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy app:8000
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		# 参加コード（?t=…）をアクセスログに残さない
		format filter {
			wrap json
			fields {
				request>uri query {
					delete t
				}
			}
		}
	}
}
